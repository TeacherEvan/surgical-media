{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.surgery-ai.dev/surgical-media/investigation_brief.schema.json",
  "title": "Surgical Media Investigation Brief",
  "description": "Stage 1 research brief: verified facts and visual anchors extracted from the subject before any scripting or rendering.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["subject", "facts", "visual_anchors", "target_format"],
  "properties": {
    "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 500 }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["claim", "source"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 500 },
          "source": { "type": "string", "minLength": 1, "maxLength": 500 },
          "metric": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "visual_anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["claim_index", "primitive"],
        "properties": {
          "claim_index": { "type": "integer", "minimum": 0 },
          "primitive": { "type": "string", "minLength": 1, "maxLength": 200 },
          "archetype": { "type": "string", "enum": ["geometry_rig", "doc_essay", "code_report", "mixed"] }
        }
      }
    },
    "target_format": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["aspect"],
      "properties": {
        "aspect": { "type": "string", "enum": ["16:9", "9:16", "1:1"] },
        "width": { "type": "integer", "minimum": 160 },
        "height": { "type": "integer", "minimum": 160 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 50, 60] },
        "max_duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "platform": { "type": "string", "maxLength": 40 }
      }
    }
  }
}
