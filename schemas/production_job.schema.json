{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.surgery-ai.dev/surgical-media/production_job.schema.json",
  "title": "Surgical Media Production Job Request",
  "description": "Input contract for the 3.0 job layer (scripts/job_model.py mirrors this).",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "topic",
    "profile",
    "target_duration_seconds",
    "platforms",
    "approval_policy",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "topic": { "type": "string", "minLength": 1, "maxLength": 300 },
    "profile": {
      "enum": ["comedy", "documentary", "education", "politics", "commercial"]
    },
    "audience": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "target_duration_seconds": { "type": "number", "minimum": 5, "maximum": 3600 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["shorts_tiktok_reels", "youtube_long", "square"] }
    },
    "approval_policy": { "enum": ["human_before_export"] },
    "budget": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["currency", "maximum_cost"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maximum_cost": { "type": "number", "minimum": 0 }
      }
    },
    "creative_constraints": { "type": "object" }
  }
}
