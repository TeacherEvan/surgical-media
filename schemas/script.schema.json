{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.surgery-ai.dev/surgical-media/script.schema.json",
  "title": "Surgical Media Beat Script",
  "description": "Input for scripts/tts_align.py: narration beats to be voiced and locked to frame-accurate timing.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["scenes"],
  "properties": {
    "title": { "type": "string", "maxLength": 200 },
    "voice": { "type": "string", "minLength": 3, "maxLength": 80, "default": "en-US-ChristopherNeural" },
    "voices": {
      "type": "object",
      "description": "Optional per-scene voice map (scene_id → voice). tts_align: CLI --voice > script.voice > per-scene override > default",
      "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 80 }
    },
    "wpm": { "type": "number", "minimum": 80, "maximum": 260, "default": 165 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["scene_id", "narration"],
        "properties": {
          "scene_id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 64 },
          "archetype": { "type": "string", "enum": ["geometry_rig", "doc_essay", "code_report", "mixed"], "default": "doc_essay" },
          "narration": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
