{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.surgery-ai.dev/surgical-media/storyboard.schema.json",
  "title": "Surgical Media Storyboard",
  "description": "Deterministic scene graph consumed by scripts/render_engine.py.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["meta", "format", "scenes"],
  "$defs": {
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" }
  },
  "properties": {
    "meta": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "format": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 160, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 160, "maximum": 3840 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 50, 60] }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["scene_id", "archetype", "duration_sec"],
        "anyOf": [{ "required": ["elements"] }, { "required": ["scene_spec"] }],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_-]+$" },
          "archetype": { "type": "string", "enum": ["geometry_rig", "doc_essay", "code_report", "mixed"] },
          "narration": { "type": "string", "maxLength": 2000 },
          "backend": {
            "type": "string",
            "enum": [
              "auto",
              "blender_hybrid",
              "blender_3d",
              "threejs_hybrid",
              "threejs_3d",
              "canvas_2d",
              "manim_math"
            ],
            "default": "auto"
          },
          "scene_spec": {
             "type": "object",
             "unevaluatedProperties": false,
             "required": ["category"],
             "properties": {
               "category": {
                 "type": "string",
                 "enum": [
                   "exploded_hardware_3d",
                   "orbital_or_field_3d",
                   "organic_serpent_3d",
                   "network_topology_3d",
                   "rigid_body_physics_3d",
                   "mathematical_manifold_3d",
                   "external_asset_3d"
                 ]
               },
               "blender_engine": { "type": "string", "enum": ["AUTO_EEVEE", "CYCLES"], "default": "AUTO_EEVEE" },
               "hud_title": { "type": "string", "maxLength": 96 },
               "explode_factor": { "type": "number", "minimum": 0.0, "maximum": 5.0, "default": 0 },
               "boolean_cutaway": { "type": "boolean", "description": "accepted, parsed by the scene router only" },
               "lighting_preset": {
                 "type": "string",
                 "enum": ["cyber_studio_volumetric", "clean_product_softbox"]
               },
               "camera_3d": {
                 "type": "object",
                 "unevaluatedProperties": false,
                 "properties": {
                   "mode": { "type": "string", "enum": ["orbit", "dolly", "crane", "static"] },
                   "focal_length_mm": { "type": "number", "minimum": 10.0, "maximum": 200.0, "default": 50 },
                   "fstop": { "type": "number", "minimum": 1.0, "maximum": 32.0, "default": 2.8 },
                   "radius_start": { "type": "number", "minimum": 0.5, "maximum": 100.0 },
                   "radius_end": { "type": "number", "minimum": 0.5, "maximum": 100.0 },
                   "azimuth_start_deg": { "type": "number", "minimum": -360.0, "maximum": 360.0 },
                   "azimuth_end_deg": { "type": "number", "minimum": -360.0, "maximum": 360.0 },
                   "elevation_deg": { "type": "number", "minimum": -90.0, "maximum": 90.0 }
                 }
               },
               "anchors_3d": {
                 "type": "array",
                 "maxItems": 8,
                 "items": {
                   "type": "object",
                   "unevaluatedProperties": false,
                   "required": ["anchor_id", "label", "metric", "local_pos"],
                   "properties": {
                     "anchor_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_-]+$" },
                     "label": { "type": "string", "maxLength": 96 },
                     "metric": { "type": "string", "maxLength": 96 },
                     "local_pos": {
                       "type": "array",
                       "minItems": 3,
                       "maxItems": 3,
                       "items": { "type": "number" }
                     },
                     "accent_hex": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|@[a-z0-9_]+)$", "default": "#38BDF8" }
                   }
                 }
               },
               "params": { "type": "object", "default": {} },
               "transparent_bg": { "type": "boolean" }
             }
           },
          "start_sec": { "type": "number", "minimum": 0 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
          "vo_wav": { "type": "string", "maxLength": 512 },
          "fade_in_sec": { "type": "number", "minimum": 0, "maximum": 2 },
          "fade_out_sec": { "type": "number", "minimum": 0, "maximum": 2 },
          "silent_beat": { "type": "boolean", "default": false },
          "camera": {
            "type": "object",
            "unevaluatedProperties": false,
            "properties": {
              "zoom_start": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
              "zoom_end": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
              "pan_x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "pan_y": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "mode": { "type": "string", "enum": ["zoom", "orbit", "static"], "default": "zoom", "description": "zoom: zoom_start→zoom_end through easing (default). orbit: center moves around pivot by orbit radius. static: zoom frozen at zoom_start; shake still applies." },
              "pivot_x": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "orbit mode only; pivot point as fraction of canvas width" },
              "pivot_y": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "orbit mode only; pivot point as fraction of canvas height" },
              "orbit_radius_start": { "type": "number", "minimum": 0.5, "maximum": 100.0, "description": "orbit mode only; orbit radius in design px" },
              "orbit_radius_end": { "type": "number", "minimum": 0.5, "maximum": 100.0, "description": "orbit mode only; defaults to orbit_radius_start" },
              "azimuth_start_deg": { "type": "number", "minimum": -360.0, "maximum": 360.0, "description": "orbit mode only; initial polar angle in design space" },
              "azimuth_end_deg": { "type": "number", "minimum": -360.0, "maximum": 360.0, "description": "orbit mode only; final polar angle; defaults to azimuth_start_deg" },
              "orbit_easing": { "type": "string", "enum": ["linear", "ease_out_expo", "ease_in_out_cubic", "ease_in_out_sine", "ease_out_back", "spring_pop"], "description": "orbit mode only; defaults to the camera's easing" },
              "elevation_deg": { "type": "number", "minimum": -90.0, "maximum": 90.0, "description": "orbit mode only; vertical offset of the orbit above the pivot" },
              "easing": { "type": "string", "enum": ["linear", "ease_out_expo", "ease_in_out_cubic", "ease_in_out_sine", "ease_out_back", "spring_pop"] },
              "shake_amplitude_px": { "type": "number", "minimum": 0.0, "maximum": 80.0 }
            }
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 48 } },
              "additionalProperties": true
            }
          },
          "words": {
            "type": "array",
            "maxItems": 400,
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "required": ["word", "start", "end"],
              "properties": {
                "word": { "type": "string", "minLength": 1, "maxLength": 120 },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 }
              }
            }
          },
          "sfx_events": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "unevaluatedProperties": false,
              "required": ["t_sec", "sfx"],
              "properties": {
                "t_sec": { "type": "number", "minimum": 0 },
                "sfx": { "type": "string", "enum": ["pop", "whoosh", "chime", "type_click", "error_buzz", "confirm", "trauma"] },
                "intensity": { "type": "number", "minimum": 0.1, "maximum": 1.0 }
              }
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "description": "Optional style bible (scripts/style.py). '@role' colour refs elsewhere resolve to the palette.",
      "unevaluatedProperties": false,
      "properties": {
        "preset": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "palette": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "ground": { "$ref": "#/$defs/hexColor" },
            "ink": { "$ref": "#/$defs/hexColor" },
            "accent": { "$ref": "#/$defs/hexColor" },
            "accent2": { "$ref": "#/$defs/hexColor" },
            "shadow": { "$ref": "#/$defs/hexColor" },
            "highlight": { "$ref": "#/$defs/hexColor" }
          }
        },
        "type": {
          "type": "object",
          "properties": {
            "display": { "type": "string" },
            "body": { "type": "string" },
            "tracking": { "type": "number" }
          }
        },
        "material": {
          "type": "object",
          "properties": {
            "family": { "enum": ["clay", "paper", "glass", "metal", "flat", "neon"] },
            "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "light": {
          "type": "object",
          "properties": {
            "key_temp_k": { "type": "number", "minimum": 1500, "maximum": 12000 },
            "fill_temp_k": { "type": "number", "minimum": 1500, "maximum": 12000 },
            "shadow_softness": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "grade": {
          "type": "object",
          "properties": {
            "grain": { "type": "number", "minimum": 0, "maximum": 1 },
            "vignette": { "type": "number", "minimum": 0, "maximum": 1 },
            "halation": { "type": "number", "minimum": 0, "maximum": 1 },
            "warmth": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "feel": { "enum": ["calm", "punchy"] },
            "ease": { "type": "string" },
            "hold": { "type": "number", "minimum": 0, "maximum": 1 },
            "drift": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "description": "Optional platform preset (scripts/platform_presets.py): caption defaults + retention budgets.",
      "unevaluatedProperties": false,
      "properties": {
        "preset": { "enum": ["shorts_tiktok_reels", "youtube_long", "square"] },
        "caption_style": { "enum": ["sticker", "editorial", "none"] },
        "hook_max_sec": { "type": "number", "minimum": 0.5, "maximum": 600 },
        "beat_max_sec": { "type": "number", "minimum": 0.5, "maximum": 600 }
      }
    },
    "audio": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "pad": { "type": "boolean", "default": true },
        "pad_level": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
        "duck_depth": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sample_rate": { "type": "integer", "enum": [44100, 48000] }
      }
    }
  }
}
