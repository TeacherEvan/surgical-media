    {"scene_id": "defence_only", "archetype": "doc_essay", "narration": "They bite when threatened."},
    {"scene_id": "guard_harvest", "archetype": "doc_essay", "narration": "Yet they guard our harvest."},
    {"scene_id": "rodents_grain", "archetype": "doc_essay", "narration": "Rats and mice destroy grain."},
    {"scene_id": "rodents_checked", "archetype": "doc_essay", "narration": "Snakes keep rodents in check."},
    {"scene_id": "free_control", "archetype": "doc_essay", "narration": "That is free pest control."},
